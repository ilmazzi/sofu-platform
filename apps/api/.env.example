APP_NAME=Sofu
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://sofu-platform.test
FRONTEND_URL=http://localhost:5173

# --- First-time DB (SQLite) ---
# touch database/database.sqlite && php artisan migrate

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local default: SQLite (create file + migrate — see apps/api README).
# For production, use PostgreSQL (example below).
DB_CONNECTION=sqlite

# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=sofu
# DB_USERNAME=sofu
# DB_PASSWORD=

# Local: `file` avoids needing PostgreSQL just for session/CSRF (Sanctum cookie). Use `database` in production if you need shared/redis-backed sessions.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:3000,127.0.0.1:3000

# CORS: comma-separated list of SPA origins allowed to call the API with cookies.
# Example (production): https://so-fu.org,https://www.so-fu.org
CORS_ALLOWED_ORIGINS=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Local: `sync` — use `redis` in production when workers run.
QUEUE_CONNECTION=sync

# Local: `file` — use `redis` in production when Redis is available.
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Payments: mock (local) or stripe
PAYMENT_PROVIDER=mock
# STRIPE_SECRET=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
