# Empty = same-origin requests via Vite proxy (recommended for local Sanctum cookie + CSRF).
# If you set a URL here, use the site origin only — never add /api (paths already include /api/v1/...).
# Wrong: http://sofu-platform.test/api  →  breaks (double /api).
# Production: set VITE_API_URL to your API (e.g. https://api.so-fu.org) and configure:
# - SESSION_DOMAIN=.so-fu.org
# - SANCTUM_STATEFUL_DOMAINS includes your SPA domain(s)
# - CORS_ALLOWED_ORIGINS includes your SPA origin(s)
VITE_API_URL=

# Dev proxy target for /api and /sanctum (vite.config.ts).
# Default: http://127.0.0.1:8000 (php artisan serve).
# If Herd owns port 80 and sofu-platform.test is correct: http://sofu-platform.test
VITE_DEV_API_PROXY=http://127.0.0.1:18080

# Stripe.js (publishable key only -- never put the secret key here)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
