# Empty = same-origin requests via Vite proxy (recommended for local Sanctum cookie + CSRF).
# If you set a full URL (e.g. http://127.0.0.1:8000), the browser cannot read XSRF-TOKEN from
# the API host when the app runs on another origin — use a proxy or same-site deployment instead.
VITE_API_URL=

# Stripe.js (publishable key only — never put the secret key here)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51S4ztRB6Qh3VFNq9ZEqSaLOR0gaOVPt7mSpitBMb00Ul7Bz1Zdk2OHgKKzl6ZbiSN7qSeinNwkyx9qukesdNkGPg00Dafgt7qm