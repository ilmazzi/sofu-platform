# Copy this file to the repository root as `.env` on the server:
# cp infra/docker/.env.example .env

SOFU_DOMAIN=so-fu.org
CADDY_EMAIL=admin@so-fu.org
HTTP_PORT=80
HTTPS_PORT=443
SOFU_IMAGE_TAG=prod

APP_NAME=Sofu
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://so-fu.org
FRONTEND_URL=https://so-fu.org
APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT
LOG_LEVEL=info

# Self-contained VPS default. For managed PostgreSQL, replace host/port/user/password/database.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sofu
DB_USERNAME=sofu
DB_PASSWORD=change_this_database_password

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SANCTUM_STATEFUL_DOMAINS=so-fu.org,www.so-fu.org
CORS_ALLOWED_ORIGINS=https://so-fu.org,https://www.so-fu.org

QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@so-fu.org
MAIL_FROM_NAME=Sofu

# Use `mock` only for staging/demo. Production payments should use `stripe`.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# Same-origin API behind Caddy. Leave empty unless API lives on a separate origin.
VITE_API_URL=

FILESYSTEM_DISK=local
SIMULATION_ENABLED=false
SOFU_PAYMENT_ATTRITION_BUFFER=0.10
