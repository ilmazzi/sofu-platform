:{$PORT:8080} {
	encode zstd gzip

	@api path /api/* /sanctum/* /up
	handle @api {
		reverse_proxy {$API_UPSTREAM} {
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
		}
	}

	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}
}
